# ==================================
# BILETIKS - Переменные окружения
# ==================================

# ----------------------------------
# БАЗА ДАННЫХ
# ----------------------------------
# Строка подключения к PostgreSQL
# Формат: postgresql://пользователь:пароль@хост:порт/имя_базы
DATABASE_URL=postgresql://user:password@localhost:5432/biletiks

# ----------------------------------
# СЕРВЕР
# ----------------------------------
# Порт сервера (Railway/Render/Fly.io устанавливают автоматически)
PORT=5000

# Публичный URL приложения (для webhook Telegram)
# Пример: https://your-app.railway.app или https://your-app.onrender.com
APP_URL=https://your-domain.com

# ----------------------------------
# TELEGRAM БОТ
# ----------------------------------
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=your-bot-token

# ID администратора для личных сообщений
# Узнать свой ID можно через бота @userinfobot в Telegram
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id

# (Опционально) ID группы для групповых уведомлений
# Если не указан, уведомления будут отправляться администратору
TELEGRAM_GROUP_ID=

# ----------------------------------
# OPENAI API
# ----------------------------------
# Ключ API OpenAI (для AI функций)
OPENAI_API_KEY=sk-your-api-key

# (Опционально) Кастомный endpoint OpenAI
OPENAI_BASE_URL=

# ----------------------------------
# АДМИН ПАНЕЛЬ
# ----------------------------------
# Пароль для доступа к админ-панели
ADMIN_PASSWORD=your-admin-password

# ----------------------------------
# INNGEST (Опционально)
# ----------------------------------
# Ключи для Inngest (если используется)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
=======
